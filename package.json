{
    "name": "@ppfeufer/stickyjs",
    "version": "0.2.0",
    "description": "A lightweight JavaScript library for creating sticky elements on a webpage.",
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "terser": "^5.51.2"
    },
    "scripts": {
        "copy:js": "mkdir -p dist && cp src/stickyjs.js dist/stickyjs.js",
        "copy:sources": "npm run copy:js",
        "build": "node src/scripts/build.js && npm run minify",
        "lint": "eslint --config eslint.config.js --ext .js --ignore-pattern '**/*.min.js' --debug",
        "minify:js": "terser dist/stickyjs.js -o dist/stickyjs.min.js --source-map \"base='dist/',url='stickyjs.min.js.map'\" --compress reduce_vars=false --mangle --format quote_style=1",
        "minify": "npm run minify:js",
        "test": "jest --config jest.config.js"
    }
}
